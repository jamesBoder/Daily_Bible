# Server Configuration
SERVER_ADDRESS=:8080
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dailybible

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Bible API Configuration
BIBLE_API_KEY=your-bible-api-key
BIBLE_API_BASE_URL=https://api.scripture.api.bible/v1
BIBLE_VERSION_ID=de4e12af7f28f599-02

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Email Validation Configuration
# Set to true in development to allow test emails, false in production
ALLOW_TEST_EMAILS=true

# Comma-separated list of test email domains (only used when ALLOW_TEST_EMAILS=true)
# These domains will be allowed even though they're not real email providers
TEST_EMAIL_DOMAINS=test.local,example.com,test.com
