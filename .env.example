# ============================================================
# Daily Bible App — Portfolio MVP
# Environment Variables Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git. It is in .gitignore.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080

# ── Database ─────────────────────────────────────────────────
# For local Docker: DB_HOST must be "localhost" (host machine)
# The docker-compose.yml overrides DB_HOST to "postgres" (service name) internally.
DB_HOST=localhost
DB_PORT=5433
DB_USER=dailybible_user
DB_PASSWORD=your_db_password_here
DB_NAME=dailybible_db

# POSTGRES_DB must match DB_NAME exactly.
# Used by the postgres container to create the database on first init.
POSTGRES_DB=dailybible_db

# ── Authentication ───────────────────────────────────────────
# Generate a secure random secret:
#   openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── Google OAuth (optional for portfolio-mvp) ────────────────
# Required only if you want Google account linking in Settings.
# The Login page does NOT have a Google button in portfolio-mvp.
# For local Docker, redirect URL must be http://localhost/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/callback

# ── Frontend URLs (fixed for local Docker) ───────────────────
FRONTEND_URL=http://localhost
REACT_APP_API_URL=http://localhost
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Bible API ────────────────────────────────────────────────
# Get your key at: https://scripture.api.bible
BIBLE_API_KEY=your_bible_api_key_here
BIBLE_API_BASE_URL=https://rest.api.bible/v1
BIBLE_VERSION_ID=de4e12af7f28f599-02

# ── Email / Resend ───────────────────────────────────────────
# Portfolio-mvp does NOT require email verification.
# Resend is only used if password reset or notifications are triggered.
# For local testing, use Resend's shared test sender (no domain needed):
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=onboarding@resend.dev
# Production (Fly.io): use your verified domain sender instead
