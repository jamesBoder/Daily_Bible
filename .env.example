# Server Configuration
SERVER_ADDRESS=:8888
FRONTEND_URL=http://localhost

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dailybible
DB_SSLMODE=disable
POSTGRES_DB=dailybible_db

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Bible API Configuration
BIBLE_API_KEY=your-bible-api-key
BIBLE_API_BASE_URL=https://api.scripture.api.bible/v1
BIBLE_VERSION_ID=de4e12af7f28f599-02

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8888/api/auth/google/callback

REACT_APP_API_URL=http://localhost:18080
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# Sentry error monitoring (leave blank to disable)
SENTRY_DSN=
REACT_APP_SENTRY_DSN=

# Email Validation Configuration
# Set to true in development to allow test emails, false in production
ALLOW_TEST_EMAILS=true

# Comma-separated list of test email domains (only used when ALLOW_TEST_EMAILS=true)
# These domains will be allowed even though they're not real email providers
TEST_EMAIL_DOMAINS=test.local,example.com,test.com

