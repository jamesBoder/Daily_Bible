# Copy this file to .env and fill in your local values.
# Never commit .env — it contains secrets.

# Server
SERVER_ADDRESS=:8888
FRONTEND_URL=http://localhost:3001

# Database (local dev — backend runs directly on host, Postgres in Docker on port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=dailybible_user
DB_PASSWORD=your_db_password_here
DB_NAME=dailybible_db
DB_SSLMODE=disable

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Bible API — https://scripture.api.bible
BIBLE_API_KEY=your_bible_api_key_here
BIBLE_API_BASE_URL=https://rest.api.bible/v1
BIBLE_VERSION_ID=de4e12af7f28f599-02

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8888/api/auth/google/callback

# Email — https://resend.com
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Production (Fly.io — leave blank for local dev)
DATABASE_URL=
PRODUCTION_FRONTEND_URL=
PRODUCTION_BACKEND_URL=
